# ─── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ─── Embedding ────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# ─── Vector Database ──────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=chator-sumenep
PINECONE_NAMESPACE=pemkab-sumenep

# ─── OpenWA (WhatsApp) ────────────────────────────────────────────────────────
# URL VPS tempat OpenWA di-deploy
OPENWA_BASE_URL=http://your-vps-ip:8002
OPENWA_API_KEY=your_openwa_api_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_SECRET=your_webhook_secret_here

# ─── RAG ──────────────────────────────────────────────────────────────────────
# Jumlah dokumen yang diambil saat retrieval
RETRIEVER_TOP_K=5
